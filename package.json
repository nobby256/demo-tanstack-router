{
  "name": "demo-tanstack-router",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "pnpm": ">=11.x.x"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "nuke": "turbo run clean && rimraf '**/node_modules'",
    "clean": "rimraf .turbo && turbo run clean",
    "dev": "turbo run dev --filter=react-app...",
    "generate": "turbo run generate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format && prettier --write .",
    "all": "turbo run all"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "rimraf": "catalog:",
    "prettier": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-perfectionist": "catalog:"
  }
}
